meta {
  name: créer 1 livre
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: inherit
}

body:json {
  {
    "titre": "Harry Potter",
    "image": "https://example.com/image.jpg",
    "annee_publication": "2001-01-01",
    "nb_page": 350,
    "lien_extrait": "https://example.com/extrait.pdf",
    "resume": "Un jeune sorcier découvre...",
    "editeur": "Gallimard",
    "auteur_fk": 1,
    "categorie_fk": 1,
    "utilisateur_fk": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
