meta {
  name: créer 1 livre
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titre": "Harry Potter à l'école des sorciers",
    "image": "https://example.com/hp1.jpg",
    "annee_publication": 1997,
    "nb_page": 350,
    "lien_extrait": "https://example.com/extrait.pdf",
    "resume": "Un jeune sorcier découvre Poudlard et ses mystères.",
    "editeur": "Gallimard",
    "authorId": 1,
    "categoryId": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
