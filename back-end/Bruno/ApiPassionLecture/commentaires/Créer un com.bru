meta {
  name: Créer un com
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/books/:book_id/comments
  body: json
  auth: bearer
}

params:path {
  book_id: 1
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "message": "Super livre !",
    "etoile": 5
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
